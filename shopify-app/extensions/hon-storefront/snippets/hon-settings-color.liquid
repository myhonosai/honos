{%- comment -%}
  Prints the value back only when it is exactly #RRGGBB (upper-case hex), else nothing. HON's database and API already
  refuse anything else; this is the storefront's own check, so a bad value can never reach the page's CSS.
{%- endcomment -%}
{%- liquid
  assign c = value | append: '' | upcase
  if c.size == 7
    assign first = c | slice: 0
    assign digits = c | slice: 1, 6
    assign rest = digits | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: 'A' | remove: 'B' | remove: 'C' | remove: 'D' | remove: 'E' | remove: 'F'
    if first == '#' and digits.size == 6 and rest == ''
      echo c
    endif
  endif
-%}
