# Protected SERVER runtime variables only; never NEXT_PUBLIC_ or browser configuration.
# See docs/architecture/PRODUCTION_AUTHENTICATION.md. Replace placeholders via a secret manager.
# Both web and API:
HON_AUTH_MODE=OIDC
HON_SESSION_JWT_SECRET=<hon-owned-random-secret-at-least-32-bytes>
HON_SESSION_AUDIENCE=<unique-hon-application-and-deployment-id>

# OIDC web server only. Explicit endpoints; validation does NOT contact the provider.
HON_PUBLIC_ORIGIN=https://<public-application-host>
HON_OIDC_ISSUER=https://<oidc-issuer-host-and-optional-tenant-path>
HON_OIDC_AUTHORIZATION_ENDPOINT=https://<authorization-endpoint>
HON_OIDC_TOKEN_ENDPOINT=https://<token-endpoint>
HON_OIDC_JWKS_URI=https://<jwks-endpoint>
HON_OIDC_CLIENT_ID=<registered-oidc-client-id>
HON_OIDC_SCOPES=openid profile email
HON_OIDC_REDIRECT_URI=https://<public-application-host>/auth/callback
HON_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
HON_OIDC_CLIENT_SECRET=<server-only-oidc-client-secret>
# Optional asymmetric allowlist, matching provider metadata. Default: RS256.
# HON_OIDC_ID_TOKEN_ALGORITHMS=RS256
# Optional provider logout so Sign out also ends the provider session (otherwise the next sign-in
# silently reuses the same account). OIDC end_session_endpoint, or Auth0 https://<tenant>/v2/logout.
# Register <HON_PUBLIC_ORIGIN>/ (with the trailing slash) as an allowed logout URL at the provider.
# HON_OIDC_END_SESSION_ENDPOINT=https://<end-session-endpoint>
# Reader-first release gate. Leave absent/false while ANY API/web reader uses the old session schema.
# Enable only after every reader is upgraded, then reauthenticate invitation recipients.
# HON_SESSION_VERIFIED_EMAIL_ENABLED=false
# Public PKCE clients: use HON_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=none and OMIT HON_OIDC_CLIENT_SECRET.

# Alternative EXPLICIT development adapter only; not needed or consulted in OIDC mode.
# HON_AUTH_MODE=MANUS_DEVELOPMENT
# MANUS_PROJECT_ID=<development-project-id>
# MANUS_JWT_SECRET=<development-adapter-signing-key-different-from-hon-key>
# MANUS_OAUTH_PORTAL_URL=https://<development-portal-host>
# MANUS_OAUTH_API_URL=https://<development-auth-api-host>
# HON_PUBLIC_ORIGIN=https://<public-preview-host>
# HON_SESSION_JWT_SECRET remains required and HON-owned in development.

# Existing runtime database/API configuration; do not use a privileged database role at runtime.
# HON_RUNTIME_DATABASE_URL=postgresql://<hon-runtime-role>:<runtime-password>@<database-host>/<database-name>
# HON_API_BASE_URL=http://<private-api-host>:<api-port>
# HON_API_PORT=<api-port>
# Required whenever NODE_ENV=production: production | staging | preview | development.
# Production/staging refuse to start without OIDC, a verified-TLS runtime database, or with DATABASE_URL present.
# HON_DEPLOYMENT_ENVIRONMENT=production
# CA for every non-local database (runtime pool, migrations, verifiers). PEM text or a file path, not both.
# Supabase: Dashboard > Database > Settings > SSL Configuration (prod-ca-2021.crt). Do not add ?sslmode= to URLs.
# HON_DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n<base64>\n-----END CERTIFICATE-----
# HON_DATABASE_CA_CERT_FILE=/run/secrets/hon-database-ca.pem
# Optional runtime pool size per API instance (1-40, default 8). Keep instances x size below the pooler limit.
# HON_RUNTIME_DATABASE_POOL_MAX=8

# HON subscription payments (B5), API server only, TEST MODE ONLY. Store both in the secret manager;
# never in the repository, logs, screenshots or chat. Live keys (sk_live_) are refused at startup.
# Without both variables the provider adapter is unconfigured and every payment call is refused.
# STRIPE_TEST_SECRET_KEY=sk_test_<stripe-test-mode-secret-or-restricted-key>
# STRIPE_TEST_WEBHOOK_SECRET=whsec_<signing-secret-of-the-test-mode-webhook-endpoint>

# Zernio, API server only. Use protected runtime secrets; never NEXT_PUBLIC_, web or build variables.
# Local hidden entry: node scripts/configure-zernio.mjs (see docs/architecture/ZERNIO_INTEGRATION.md).
# ZERNIO_API_KEY=<dedicated-read-only-profile-scoped-key>
# External credential verification remains disabled unless separately authorized:
# HON_ZERNIO_VERIFICATION_APPROVED=false

# Creative AI providers (C2). All OFF: production still wires no provider until HON media storage (C3) exists.
# Keys are pasted by the owner into the API server environment only; never in the browser or the repository.
# HON_CREATIVE_HIGGSFIELD_APPROVED=false
# HIGGSFIELD_API_KEY_ID=
# HIGGSFIELD_API_SECRET=
# HON_CREATIVE_HEYGEN_APPROVED=false
# HEYGEN_API_KEY=
# HeyGen stock voice and one stock avatar per HON look style (unset style = that look cannot make talking videos).
# HON_CREATIVE_HEYGEN_VOICE_ID=
# HON_CREATIVE_HEYGEN_AVATAR_REALISTIC=
# HON_CREATIVE_HEYGEN_AVATAR_ILLUSTRATED=
# HON_CREATIVE_HEYGEN_AVATAR_CHIBI=
