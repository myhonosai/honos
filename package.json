{
  "name": "hon-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @hon/web dev",
    "dev:api": "pnpm --filter @hon/api start:dev",
    "prepare:workspace": "pnpm --filter @hon/auth build && pnpm --filter @hon/contracts build && pnpm --filter @hon/config build && pnpm --filter @hon/domain build && pnpm --filter @hon/database build && pnpm --filter @hon/design-system build",
    "build": "pnpm prepare:workspace && pnpm -r --if-present build",
    "check": "pnpm prepare:workspace && pnpm -r --if-present check",
    "test": "pnpm prepare:workspace && pnpm -r --if-present test",
    "db:migrate": "pnpm --filter @hon/database db:migrate",
    "db:verify-rls": "pnpm --filter @hon/database db:verify-rls",
    "db:test-security": "pnpm --filter @hon/database db:test-security",
    "db:test-outbox": "pnpm --filter @hon/database db:test-outbox",
    "db:test-curriculum": "pnpm --filter @hon/database db:test-curriculum",
    "db:test-booking": "pnpm --filter @hon/database db:test-booking",
    "db:test-knowledge": "pnpm --filter @hon/database db:test-knowledge",
    "db:test-planned-absence": "pnpm --filter @hon/database db:test-planned-absence",
    "db:test-crm-appointments": "pnpm --filter @hon/database db:test-crm-appointments",
    "db:test-communication-consents": "pnpm --filter @hon/database db:test-communication-consents",
    "db:test-communication-messages": "pnpm --filter @hon/database db:test-communication-messages",
    "db:test-billing-invoices": "pnpm --filter @hon/database db:test-billing-invoices",
    "db:test-billing-membership-activation": "pnpm --filter @hon/database db:test-billing-membership-activation",
    "db:test-work-items": "pnpm --filter @hon/database db:test-work-items",
    "db:test-ai-usage": "pnpm --filter @hon/database db:test-ai-usage",
    "db:test-ai-team": "pnpm --filter @hon/database db:test-ai-team",
    "db:test-ai-providers": "pnpm --filter @hon/database db:test-ai-providers",
    "db:test-operations-report": "pnpm --filter @hon/database db:test-operations-report",
    "db:test-parent-schedule": "pnpm --filter @hon/database db:test-parent-schedule",
    "db:test-parent-knowledge": "pnpm --filter @hon/database db:test-parent-knowledge",
    "db:check": "pnpm --filter @hon/database check:migrations",
    "db:test-ai-plans": "pnpm --filter @hon/database db:test-ai-plans"
  }
}
