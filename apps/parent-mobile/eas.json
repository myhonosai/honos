{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_HON_API_URL": "http://10.0.2.2:4000" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_HON_API_URL": "https://REPLACE-WITH-STAGING-API" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_HON_API_URL": "https://REPLACE-WITH-PRODUCTION-API" }
    }
  },
  "submit": {
    "production": {}
  }
}
