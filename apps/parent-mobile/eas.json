{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_HON_API_URL": "http://10.0.2.2:4000",
        "EXPO_PUBLIC_HON_WEB_URL": "http://10.0.2.2:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_HON_API_URL": "https://REPLACE-WITH-STAGING-API",
        "EXPO_PUBLIC_HON_WEB_URL": "https://REPLACE-WITH-STAGING-WEB"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_HON_API_URL": "https://REPLACE-WITH-PRODUCTION-API",
        "EXPO_PUBLIC_HON_WEB_URL": "https://REPLACE-WITH-PRODUCTION-WEB"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
